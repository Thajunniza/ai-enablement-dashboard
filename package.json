{
  "name": "ai-enablement-dashboard",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]": {
        "kind": "mocked",
        "users": {
          "admin": {
            "password": "admin",
            "roles": ["DashboardViewer", "DashboardAdmin"]
          },
          "viewer": {
            "password": "viewer",
            "roles": ["DashboardViewer"]
          }
        }
        },
      "destinations": true,
      "html5-repo": true
    }
  }
}
