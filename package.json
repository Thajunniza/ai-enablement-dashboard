{
  "name": "aiEnablementDashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cds-serve",
    "watch-ai_enablement_dashboard_ui": "cds watch --open ai.enablement.dashboard.aienablementdashboardui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy aiEnablementDashboard --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-ai_initiatives-overview": "cds watch --open com.sap.aiinitiativesoverview/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-project1": "cds watch --open aptiv.com.project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-aiinitiativesoverview": "cds watch --open com.sap.aiinitiativesoverview/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": {
          "kind": "postgres",
          "pool": {
            "acquireTimeoutMillis": 10000,
            "max": 10
          }
        }
      },
      "destinations": true,
      "html5-repo": true,
      "IAS_SCIM": {
        "kind": "rest",
        "credentials": {
          "destination": "IAS_SCIM"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
          "admin": {
            "password": "admin",
            "roles": ["DashboardViewer", "DashboardUserDetail", "DashboardAdmin"]
          },
          "detail": {
            "password": "detail",
            "roles": ["DashboardViewer", "DashboardUserDetail"]
          },
          "viewer": {
            "password": "viewer",
            "roles": ["DashboardViewer"]
          }
        }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/aiinitiativesoverview"
  ]
}