<mvc:View
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:macros="sap.fe.macros"
    controllerName="com.sap.aiinitiativesoverview.ext.view.Main">

    <macros:Page
        id="Page"
        title="{i18n>app_title}"
        showFooter="false">

        <macros:headerContent>
            <VBox id="headerContentBox">
                <Text
                    id="dataSourceNote"
                    text="{i18n>datasource_note}"
                    class="sapThemeSmallText" />
            </VBox>
        </macros:headerContent>

        <macros:items>
            <l:DynamicSideContent
                id="initiativesSideContentLayout"
                sideContentPosition="Begin"
                equalSplit="false"
                sideContentVisibility="AlwaysShow"
                sideContentWidthM="240px"
                sideContentWidthL="260px"
                sideContentWidthXL="280px">

                <!-- Filter bar. The controls are in place; the handlers are placeholders until phase 2. -->
                <l:sideContent>
                    <VBox id="filterPanel" class="aiedFilterPanel">

                        <SearchField
                            id="initiativeSearchField"
                            placeholder="{i18n>filter_search_placeholder}"
                            search=".onSearchInitiatives"
                            class="aiedFilterSearch" />

                        <Title
                            id="statusFacetTitle"
                            text="{i18n>filter_status_title}"
                            level="H6"
                            class="aiedFilterSectionTitle" />
                        <List
                            id="statusFacetList"
                            mode="SingleSelectMaster"
                            selectionChange=".onStatusFilterChange"
                            class="aiedFilterStatusList aiedFilterSectionGap">
                            <!-- The key in customData is what the logic will read, not the translated title -->
                            <StandardListItem id="statusFacetAll" title="{i18n>filter_all}">
                                <customData>
                                    <core:CustomData key="status" value="" />
                                </customData>
                            </StandardListItem>
                            <StandardListItem id="statusFacetLive" title="{i18n>filter_live}">
                                <customData>
                                    <core:CustomData key="status" value="Live" />
                                </customData>
                            </StandardListItem>
                            <StandardListItem id="statusFacetComingSoon" title="{i18n>filter_comingSoon}">
                                <customData>
                                    <core:CustomData key="status" value="ComingSoon" />
                                </customData>
                            </StandardListItem>
                        </List>

                        <Title
                            id="ownerFacetTitle"
                            text="{i18n>filter_owner_title}"
                            level="H6"
                            class="aiedFilterSectionTitle" />
                        <Select
                            id="ownerFacetSelect"
                            width="100%"
                            change=".onOwnerFilterChange"
                            class="aiedFilterSelect aiedFilterSectionGap">
                            <core:Item id="ownerFacetAll" key="" text="{i18n>filter_allOwners}" />
                        </Select>

                        <Title
                            id="quickFiltersTitle"
                            text="{i18n>filter_quick_title}"
                            level="H6"
                            class="aiedFilterSectionTitle" />
                        <HBox id="quickFiltersRow" wrap="Wrap" class="aiedFilterSectionGap">
                            <Button
                                id="quickFilterHasUsers"
                                text="{i18n>filter_hasEnabledUsers}"
                                press=".onQuickFilterToggle"
                                class="aiedQuickFilterChip sapUiTinyMarginEnd sapUiTinyMarginBottom" />
                        </HBox>

                    </VBox>
                </l:sideContent>

                <l:mainContent>
                    <f:GridContainer id="initiativesGridContainer" items="{/Initiatives}" class="aiedgrid">
                        <f:layout>
                            <f:GridContainerSettings columnSize="20rem" rowSize="auto" gap="1.5rem" />
                        </f:layout>
                        <f:items>
                            <VBox id="initiativeCard" class="aiedCard">

                                <FlexBox
                                    id="initiativeTitleRow"
                                    justifyContent="SpaceBetween"
                                    alignItems="Start"
                                    renderType="Bare"
                                    class="sapUiTinyMarginBottom">
                                    <ObjectIdentifier
                                        id="initiativeTitle"
                                        title="{name}"
                                        titleActive="{path: 'status', formatter: '.formatter.isLive'}"
                                        titlePress=".onSelectProduct"
                                        class="aiedCardTitle" />
                                    <ObjectStatus
                                        id="initiativeStatus"
                                        text="{path: 'status', formatter: '.formatter.statusText'}"
                                        inverted="true"
                                        state="{path: 'status', formatter: '.formatter.statusState'}" />
                                </FlexBox>

                                <FlexBox
                                    id="initiativeTitleRow2"
                                    justifyContent="SpaceBetween"
                                    alignItems="Start"
                                    renderType="Bare"
                                    class="sapUiTinyMarginBottom">
                                    <Text
                                        id="initiativeOwner"
                                        text="{= ${owner} ? (${i18n>card_owner} + ' ' + ${owner}) : '' }"
                                        class="aiedCardOwner sapUiTinyMarginBottom" />
                                    <HBox
                                        id="launchDateRow"
                                        alignItems="Center"
                                        class="aiedCardOwner sapUiTinyMarginTop"
                                        visible="{path: 'status', formatter: '.formatter.isLive'}">
                                        <core:Icon
                                            id="launchDateIcon"
                                            src="sap-icon://calendar"
                                            color="Neutral"
                                            class="sapUiTinyMarginEnd" />
                                        <Text
                                            id="launchDateValue"
                                            text="{launchDate}" />
                                    </HBox>
                                </FlexBox>

                                <VBox
                                    id="enabledUsersBox"
                                    class="aiedDivider sapUiTinyMarginBottom">
                                    <Title
                                        id="enabledUsersValue"
                                        text="{enabledUsers}"
                                        level="H3"
                                        class="aiedKpiValue" />
                                    <Text
                                        id="enabledUsersLabel"
                                        text="{i18n>card_enabledUsers_label}"
                                        class="sapThemeSmallText" />
                                    <Text
                                        id="enabledUsersSyncNote"
                                        text="{i18n>card_enabledUsers_sync}"
                                        class="aiedKpiNote" />
                                </VBox>

                                <Link
                                    id="viewDetailsLink"
                                    text="{i18n>card_viewDetails}"
                                    press=".onSelectProduct"
                                    class="aiedViewDetails sapUiSmallMarginTop"
                                    visible="{path: 'status', formatter: '.formatter.isLive'}" />

                            </VBox>
                        </f:items>
                    </f:GridContainer>
                </l:mainContent>

            </l:DynamicSideContent>
        </macros:items>

    </macros:Page>

</mvc:View>