{
	"_version": "1.89.0",
	"sap.app": {
		"id": "com.sap.aiinitiativesoverview",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:fpm",
			"version": "1.33.0",
			"toolsId": "053ad18c-6e1c-45b8-97b0-136649e44d0a"
		},
		"dataSources": {
			"mainService": {
				"uri": "/dashboard/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"AIInitiative-overview": {
					"semanticObject": "AIInitiative",
					"action": "overview",
					"title": "{{AIInitiative-overview.flpTitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.153.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.core": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.sap.aiinitiativesoverview.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"name": "InitiativesMain",
					"pattern": ":?query:",
					"target": "InitiativesMain"
				}
			],
			"targets": {
				"InitiativesMain": {
					"type": "Component",
					"id": "InitiativesMain",
					"name": "sap.fe.core.fpm",
					"options": {
						"settings": {
							"navigation": {},
							"contextPath": "/Initiatives",
							"viewName": "com.sap.aiinitiativesoverview.ext.view.Main"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "aiEnablementDashboard"
	}
}